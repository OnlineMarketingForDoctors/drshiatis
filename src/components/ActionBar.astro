---
// Sticky pair of actions pinned to the bottom of the screen on a phone, so
// booking and enquiring are always a thumb away. It replaces the book button
// in the compact bar at the same breakpoint, which is why that one hides.
import { site } from '../data/site.js';
---

<div class="actionbar" data-actionbar>
  <a class="actionbar__btn actionbar__btn--book" href={site.bookingHref}>
    Book now
  </a>
  <a class="actionbar__btn actionbar__btn--ask" href="/contact">
    Contact us
  </a>
</div>

<style>
  .actionbar { display: none; }

  @media (max-width: 900px) {
    .actionbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      /* Under the mobile menu and the cookie banner, over everything else. */
      z-index: 35;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: rgba(216, 189, 124, 0.45);
      border-top: 1px solid rgba(216, 189, 124, 0.45);
      /* Clear of the iOS home indicator. */
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .actionbar__btn {
      display: grid;
      place-items: center;
      padding-block: 1.05rem;
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-align: center;
    }
    .actionbar__btn--book { background: var(--gold); color: var(--emerald-deep); }
    .actionbar__btn--ask { background: var(--emerald-deep); color: var(--ivory); }
    .actionbar__btn:active { opacity: 0.85; }
  }

  /* A phone in landscape has too little height to give a bar away. */
  @media (max-width: 900px) and (max-height: 420px) {
    .actionbar { display: none; }
  }
</style>
