---
// Procedure lists mirror the categories on the current drshiatis.com site.
const tiles = [
  {
    label: 'Breast', href: '/surgical', img: '/images/tile-breast.webp', alt: 'Woman in an ivory silk camisole looking back over her shoulder', pos: 'left',
    items: ['Breast augmentation', 'Breast reduction', 'Breast lift (mastopexy)', 'Breast lift with implants', 'Fat transfer (lipomodelling)', 'Breast asymmetry correction', 'Implant removal and auto-augmentation'],
  },
  {
    label: 'Body', href: '/surgical', img: '/images/tile-body.webp', alt: 'Profile of a woman in an ivory bodysuit against blush marble', pos: 'left',
    items: ['Tummy tuck (abdominoplasty)', 'Body lift', 'Liposuction and liposculpting', 'Arm lift', 'Thigh lift', 'Mummy makeover'],
  },
  {
    label: 'For men', href: '/for-men', img: '/images/tile-men.webp', alt: 'Man in a white linen shirt seated against an emerald wall', pos: 'right',
    items: ['Gynaecomastia surgery', '3D abdominal liposculpting', 'Hair loss prevention'],
  },
  {
    label: 'Face', href: '/surgical', img: '/images/tile-face.webp', alt: 'Close crop of a woman\'s eyes and brow', pos: 'right',
    items: ['Upper blepharoplasty', 'Prominent ear correction', 'Earlobe reduction', 'Earlobe revision', 'Lip lift', 'Mole removal', 'Keloid scar treatment'],
  },
];
---

<section class="proc section" id="expertise" aria-labelledby="expertise-title">
  <div class="container">
    <header class="proc__head" data-reveal-group>
      <div>
        <p class="eyebrow eyebrow--gold" data-reveal>Areas of expertise</p>
        <h2 class="h2" id="expertise-title" data-reveal>Considered surgery, <em class="italic">never standard</em></h2>
      </div>
      <p class="lead measure-narrow" data-reveal>Breast, body, face and more, with one approach throughout. Every plan is built around your own anatomy and what you hope to achieve, not a technique applied to everyone.</p>
    </header>

    <div class="proc__grid">
      {tiles.filter(t => t.pos === 'left').map((t) => (
        <a class="proc__tile cover" href={t.href} data-img-reveal aria-label={`${t.label}: ${t.items.join(', ')}`}>
          <img src={t.img} alt={t.alt} width="900" height="1350" loading="lazy" decoding="async" />
          <span class="proc__tile-body">
            <span class="proc__tile-label">{t.label}</span>
            <ul class="proc__tile-list" aria-hidden="true">
              {t.items.map((item) => <li>{item}</li>)}
            </ul>
          </span>
        </a>
      ))}

      <div class="proc__centre cover" data-img-reveal>
        <img src="/images/mosaic-centre.webp" alt="Woman in an ivory silk dress turning in sunlight in front of emerald curtains" width="1800" height="1208" loading="lazy" decoding="async" />
        <div class="proc__centre-content on-dark" data-reveal-group>
          <p class="eyebrow" data-reveal>Most of the practice</p>
          <h3 class="h2 italic" data-reveal>Breast and body surgery</h3>
          <p class="proc__copy" data-reveal>
            Augmentation, reduction and uplift. Tummy tuck, liposuction and body contouring. Gynaecomastia surgery for men. Every plan is built around your anatomy, never a standard technique.
          </p>
          <a class="btn btn--ivory" href="/surgical" data-reveal>
            Explore procedures
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      {tiles.filter(t => t.pos === 'right').map((t) => (
        <a class="proc__tile cover" href={t.href} data-img-reveal aria-label={`${t.label}: ${t.items.join(', ')}`}>
          <img src={t.img} alt={t.alt} width="900" height="1350" loading="lazy" decoding="async" />
          <span class="proc__tile-body">
            <span class="proc__tile-label">{t.label}</span>
            <ul class="proc__tile-list" aria-hidden="true">
              {t.items.map((item) => <li>{item}</li>)}
            </ul>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .proc__head .h2 { margin-top: 1rem; max-width: 9.5em; }

  .proc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
    height: min(88vh, 62vw);
    min-height: 34rem;
  }

  .proc__centre {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    align-items: flex-end;
  }
  .proc__centre::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 42, 33, 0.85) 0%, rgba(10, 42, 33, 0.35) 45%, rgba(10, 42, 33, 0) 75%);
    pointer-events: none;
  }
  .proc__centre > img {
    position: absolute;
    inset: 0;
    object-position: 0% center;
    transition: transform 1.4s var(--ease-out);
  }
  .proc__centre-content {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 3.5vw, 3.5rem);
    max-width: 34rem;
    color: var(--ivory);
  }
  .proc__centre-content .h2 { margin-top: 0.9rem; }
  .proc__copy {
    margin-block: 1.25rem 1.75rem;
    max-width: 30em;
    color: rgba(244, 238, 228, 0.85);
  }

  .proc__tile {
    display: block;
    color: var(--ivory);
  }
  .proc__tile > img {
    position: absolute;
    inset: 0;
    transition: transform 1.2s var(--ease-out);
  }
  .proc__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 42, 33, 0.7), rgba(10, 42, 33, 0) 55%);
  }
  /* Deeper wash that fades in on hover so the list reads over the photo. */
  .proc__tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(10, 42, 33, 0.92) 0%, rgba(10, 42, 33, 0.6) 60%, rgba(10, 42, 33, 0.25) 100%);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .proc__tile:hover::before,
  .proc__tile:focus-visible::before { opacity: 1; }
  .proc__tile:hover > img,
  .proc__tile:focus-visible > img { transform: scale(1.06); }

  .proc__tile-body {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 2;
    display: block;
  }
  .proc__tile-label {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
    letter-spacing: 0.02em;
  }
  .proc__tile-list {
    display: grid;
    gap: 0.25rem;
    max-height: 0;
    margin-top: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(0.5rem);
    transition: max-height 0.7s var(--ease-out), opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out), margin-top 0.5s var(--ease-out);
  }
  .proc__tile-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: rgba(244, 238, 228, 0.92);
  }
  .proc__tile-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.55rem;
    height: 1px;
    background: var(--gold-light);
  }
  .proc__tile:hover .proc__tile-list,
  .proc__tile:focus-visible .proc__tile-list {
    max-height: 18rem;
    margin-top: 0.8rem;
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .proc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto repeat(2, 60vw);
      height: auto;
      min-height: 0;
    }
    .proc__centre {
      grid-column: 1 / -1;
      grid-row: 1;
      aspect-ratio: 4 / 5;
    }
    .proc__tile { grid-column: auto; grid-row: auto; }
    .proc__tile-body { left: 1rem; right: 1rem; bottom: 0.9rem; }
    .proc__tile-list li { font-size: 0.78rem; }
  }
</style>
