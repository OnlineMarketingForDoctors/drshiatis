---
// The bar of in-page links that follows you down a long procedure page. It
// sticks under the site bar and marks the section you are in.
interface Props { sections: { id: string; label: string }[] }
const { sections } = Astro.props;
---

<nav class="secnav" aria-label="On this page" data-secnav>
  <div class="secnav__scroll">
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-secnav-link={s.id}>{s.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .secnav {
    position: sticky;
    top: 4.25rem;
    z-index: 20;
    background: var(--emerald-deep);
    color: var(--ivory);
    border-block: 1px solid rgba(216, 189, 124, 0.25);
  }
  .secnav__scroll {
    overflow-x: auto;
    scrollbar-width: none;
    width: min(100% - 2.5rem, var(--container, 76rem));
    margin-inline: auto;
  }
  .secnav__scroll::-webkit-scrollbar { display: none; }
  .secnav ul {
    display: flex;
    justify-content: center;
    gap: clamp(0.9rem, 2vw, 2rem);
    min-width: max-content;
    margin-inline: auto;
  }
  .secnav a {
    display: block;
    padding-block: 0.95rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(244, 238, 228, 0.72);
    border-bottom: 2px solid transparent;
    transition: color 0.3s, border-color 0.3s;
  }
  .secnav a:hover { color: var(--ivory); }
  .secnav a.is-current { color: var(--gold-light); border-bottom-color: var(--gold); }

  @media (max-width: 900px) {
    .secnav { top: 4.25rem; }
    .secnav ul { justify-content: flex-start; }
  }
</style>
