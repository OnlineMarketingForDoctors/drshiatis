---
import { featured, DOCTIFY_URL } from '../data/reviews.js';
import Stars from './Stars.astro';
---

<section class="testi" aria-labelledby="testi-title" data-testi>
  <div class="testi__bg" aria-hidden="true" data-parallax data-parallax-strength="10">
    <img src="/images/testimonial-bg.webp" alt="" width="2400" height="1018" loading="lazy" decoding="async" />
  </div>

  <div class="container testi__inner">
    <p class="eyebrow testi__label" id="testi-title" data-reveal>Patient testimonials</p>

    <div class="testi__stage">
      <button class="testi__arrow testi__arrow--prev" type="button" data-testi-prev aria-label="Previous testimonial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>

      <div class="testi__slides" aria-live="polite">
        {featured.map((f, i) => (
          <figure class="testi__slide" data-testi-slide class:list={[{ 'is-active': i === 0 }]} aria-hidden={i !== 0}>
            <Stars class="testi__stars" />
            <blockquote class="testi__quote italic">
              <p>“{f.quote}”</p>
            </blockquote>
            <figcaption class="testi__cite small">
              Verified patient <span aria-hidden="true">·</span> {f.procedure} <span aria-hidden="true">·</span> {f.date}
            </figcaption>
          </figure>
        ))}
      </div>

      <button class="testi__arrow testi__arrow--next" type="button" data-testi-next aria-label="Next testimonial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <a class="link-rule testi__more" href={DOCTIFY_URL} target="_blank" rel="noopener" data-reveal>Read more on Doctify</a>

  </div>
</section>

<style>
  .testi {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--ivory);
    color: var(--ink);
    text-align: center;
  }
  .testi__bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
  }
  .testi__bg img { width: 100%; height: 100%; object-fit: cover; }
  /* A soft ivory pool behind the quote so the type stays clean over the marble. */
  .testi::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 60% 55% at center 42%, rgba(244, 238, 228, 0.7) 0%, rgba(244, 238, 228, 0.35) 55%, rgba(244, 238, 228, 0) 100%);
  }

  .testi__inner {
    padding-block: var(--section);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .testi__label {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(28, 27, 24, 0.25);
    letter-spacing: 0.3em;
    color: var(--ink-soft);
  }

  .testi__stage {
    position: relative;
    width: 100%;
    max-width: 62rem;
    margin-top: clamp(3rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.5rem, 3vw, 3rem);
  }

  .testi__slides {
    position: relative;
    display: grid;
    min-height: 16rem;
  }
  .testi__slide {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
    pointer-events: none;
  }
  .testi__slide.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .testi__stars { color: var(--gold); }
  .testi__quote {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.5vw, 2.3rem);
    line-height: 1.35;
    font-variation-settings: 'opsz' 60;
    text-wrap: balance;
  }
  .testi__cite { color: var(--ink-soft); letter-spacing: 0.04em; }

  .testi__arrow {
    width: 3.4rem;
    height: 3.4rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(28, 27, 24, 0.35);
    border-radius: 50%;
    color: var(--ink);
    transition: border-color 0.35s, background-color 0.35s, color 0.35s;
  }
  .testi__arrow:hover { background: var(--emerald); color: var(--ivory); border-color: var(--emerald); }
  .testi__arrow svg { width: 1.2rem; height: 1.2rem; }

  .testi__more { margin-top: clamp(2.5rem, 6vh, 4rem); color: var(--emerald); }

  @media (max-width: 700px) {
    .testi__stage { grid-template-columns: 1fr; }
    .testi__arrow { display: none; }
  }
</style>
