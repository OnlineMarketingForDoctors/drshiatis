---
import { site } from '../data/site.js';

const VIDEO_ID = 'hLFJKqazyEQ';
---

<section class="hero" data-hero>
  <div class="hero__media" data-parallax data-parallax-strength="12">
    <div class="hero__video" data-hero-video={VIDEO_ID}>
      <div data-yt-mount></div>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <h1 class="hero__title" data-hero-title>
      <span class="hero__line"><span class="hero__name display italic">{site.surgeon}</span></span>
      <span class="hero__line"><span class="hero__quals">{site.qualifications}</span></span>
    </h1>

    <span class="rule rule--center hero__rule" data-hero-rule aria-hidden="true"></span>

    <p class="hero__role" data-hero-line>Consultant Plastic &amp; Reconstructive Surgeon</p>
    <p class="eyebrow eyebrow--light hero__eyebrow" data-hero-line>
      Breast and body surgery <span class="hero__sep" aria-hidden="true">|</span> London
    </p>

    <button class="hero__play" type="button" data-lightbox-open={VIDEO_ID} data-hero-line>
      <span class="hero__play-ring" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
      </span>
      <span class="hero__play-label">Watch the film</span>
    </button>
  </div>

  <a class="hero__scroll" href="#credentials" data-hero-line>
    <span class="eyebrow eyebrow--light">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    color: var(--ivory);
    /* Plain black ground: what shows before the film loads, and behind it. */
    background: #000;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: -6% 0;
    z-index: -1;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
    pointer-events: none;
  }
  .hero__video.is-playing { opacity: 1; }
  /* Cover the box whatever the viewport ratio, cropping the 16:9 frame. */
  .hero__video :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78vh);
    height: max(100%, 56.25vw);
    transform: translate(-50%, -50%);
    border: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    /* Soft lift at the foot for the type. */
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.35) 22%, rgba(0, 0, 0, 0) 48%);
  }

  /* Translucent band behind the header, fading to nothing. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.55) 18%, rgba(0, 0, 0, 0) 46%);
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(12rem, 26vh, 17rem);
    padding-bottom: clamp(6rem, 13vh, 10rem);
  }

  /* A soft pool behind the type so it holds against bright video frames,
     wide enough that it reads as a vignette rather than a box. */
  .hero__content { z-index: 1; }
  .hero__content::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(120vw, 1500px);
    height: 120%;
    transform: translate(-50%, -46%);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.45) 30%,
      rgba(0, 0, 0, 0.2) 52%,
      rgba(0, 0, 0, 0) 72%
    );
  }

  /* Each line is masked for the entrance reveal. The padding gives the
     italic descenders and swashes room so nothing clips; the negative
     margins cancel it out of the layout. */
  .hero__name {
    display: block;
    font-size: clamp(2.1rem, 7.2vw, 6.4rem);
    white-space: nowrap;
    color: var(--ivory);
  }
  .hero__quals {
    display: block;
    margin-top: clamp(0.6rem, 1.4vh, 1.1rem);
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 1.15vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--gold-light);
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0.12em 0.25em 0.28em;
    margin: -0.12em -0.25em -0.28em;
  }
  .hero__line > span { transform: translateY(110%); }

  .hero__rule {
    width: 5rem;
    margin-block: clamp(1.4rem, 3vh, 2.2rem);
    transform: scaleX(0);
  }

  .hero__role {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.5vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ivory);
  }
  .hero__eyebrow { margin-top: 0.65rem; color: var(--ivory); }
  .hero__sep {
    display: inline-block;
    margin-inline: 0.5em;
    color: rgba(244, 238, 228, 0.45);
  }

  [data-hero-line] { opacity: 0; transform: translateY(1rem); }

  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(1.75rem, 4vh, 2.75rem);
    color: var(--ivory);
  }
  .hero__play-ring {
    width: 4.25rem;
    height: 4.25rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(244, 238, 228, 0.7);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background-color 0.4s var(--ease-out), color 0.4s, transform 0.4s var(--ease-out), border-color 0.4s;
  }
  .hero__play-ring svg { width: 1.3rem; height: 1.3rem; margin-left: 0.15rem; }
  .hero__play:hover .hero__play-ring,
  .hero__play:focus-visible .hero__play-ring {
    background: var(--ivory);
    color: var(--emerald);
    border-color: var(--ivory);
    transform: scale(1.06);
  }
  .hero__play-label {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__scroll .eyebrow { writing-mode: vertical-rl; }
  .hero__scroll-line {
    width: 1px;
    height: 3.5rem;
    background: rgba(244, 238, 228, 0.5);
    overflow: hidden;
    position: relative;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold-light);
    transform: translateY(-100%);
    animation: scroll-drip 2.2s var(--ease-in-out) infinite;
  }
  @keyframes scroll-drip {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }

  :global(.reduced-motion) [data-hero-line],
  :global(.no-js) [data-hero-line] { opacity: 1; transform: none; }
  :global(.reduced-motion) .hero__line > span,
  :global(.no-js) .hero__line > span { transform: none; }
  :global(.reduced-motion) .hero__rule,
  :global(.no-js) .hero__rule { transform: none; }
  :global(.reduced-motion) .hero__scroll-line::after { animation: none; transform: none; }

  @media (max-width: 900px) {
    .hero__content { padding-top: 8rem; }
    .hero__scroll { display: none; }
    .hero__role { font-size: 0.9rem; letter-spacing: 0.18em; }
    .hero__quals { letter-spacing: 0.24em; }
  }
</style>
