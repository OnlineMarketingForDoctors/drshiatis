---
import { reviews } from '../data/reviews.js';
import Stars from './Stars.astro';
---

<section class="reviews section" id="reviews" aria-label="Patient reviews">
  <div class="reviews__viewport" data-reviews>
    <ul class="reviews__track container" data-reviews-track>
      {[0, 1].map((copy) => reviews.map((r) => (
        <li class="reviews__card" data-reviews-card aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
          <div class="reviews__card-top">
            <Stars class="reviews__stars" />
            <img class="reviews__card-logo" src="/images/doctify.svg" alt="Doctify" width="120" height="32" loading="lazy" decoding="async" />
          </div>
          <p class="eyebrow reviews__proc">{r.procedure}</p>
          <blockquote class="reviews__quote">
            <p data-review-text>{r.text}</p>
          </blockquote>
          <button
            class="reviews__more"
            type="button"
            data-review-more
            aria-expanded="false"
            tabindex={copy === 1 ? -1 : undefined}
            hidden
          >Read more</button>
        </li>
      )))}
    </ul>
  </div>

</section>

<style>
  .reviews {
    overflow: hidden;
    /* Shares the flagship index's ground so the two read as one run, which
       is also why the head is trimmed: the index above supplies the space. */
    background: var(--ivory-2);
    padding-top: clamp(1.5rem, 3vw, 2.75rem);
  }

  .reviews__viewport { position: relative; }
  .reviews__track {
    display: flex;
    gap: clamp(2rem, 3.5vw, 3.5rem);
    overflow-x: auto;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 0.5rem 1.5rem;
    cursor: grab;
  }
  .reviews__track.is-dragging { cursor: grabbing; }
  .reviews__track::-webkit-scrollbar { display: none; }

  /* No frame and no rule: each review is a plain column of type, held apart
     by the gap alone, so the run reads as quiet as it is. */
  .reviews__card {
    position: relative;
    flex: 0 0 clamp(17rem, 25vw, 23rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .reviews__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .reviews__card-logo {
    height: 1.05rem;
    width: auto;
    opacity: 0.75;
  }
  .reviews__proc { color: var(--emerald); }
  .reviews__quote {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    flex: 1;
  }
  .reviews__quote p {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Expanded, and for anyone without JS, who has no way to open it. */
  .reviews__card.is-open .reviews__quote p,
  :global(.no-js) .reviews__quote p {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .reviews__more {
    align-self: flex-start;
    margin-top: -0.2rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid rgba(184, 150, 79, 0.5);
    padding-bottom: 0.15rem;
    transition: color 0.3s, border-color 0.3s;
  }
  .reviews__more:hover { color: var(--emerald); border-color: var(--emerald); }
</style>
