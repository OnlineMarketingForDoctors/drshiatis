---
import { reviews } from '../data/reviews.js';
import Stars from './Stars.astro';
---

<section class="reviews section" id="reviews" aria-label="Patient reviews">
  <div class="container">
    <header class="reviews__head" data-reveal-group>
      <div class="reviews__controls" data-reveal>
        <button class="reviews__arrow" type="button" data-reviews-prev aria-label="Previous reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>
        <button class="reviews__arrow" type="button" data-reviews-next aria-label="Next reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="reviews__viewport" data-reviews>
    <ul class="reviews__track container" data-reviews-track>
      {[0, 1].map((copy) => reviews.map((r) => (
        <li class="reviews__card" data-reviews-card aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
          <div class="reviews__card-top">
            <Stars class="reviews__stars" />
            <img class="reviews__card-logo" src="/images/doctify.svg" alt="Doctify" width="120" height="32" loading="lazy" decoding="async" />
          </div>
          <p class="eyebrow reviews__proc">{r.procedure}</p>
          <blockquote class="reviews__quote">
            <p>{r.text}</p>
          </blockquote>
          <footer class="reviews__meta small">
            <span>Verified patient</span>
            <span aria-hidden="true">·</span>
            <time>{r.date}</time>
          </footer>
        </li>
      )))}
    </ul>
  </div>

</section>

<style>
  .reviews {
    overflow: hidden;
    /* Shares the flagship index's ground so the two read as one run, which
       is also why the foot is trimmed: the index supplies the space below. */
    background: var(--ivory-2);
    padding-bottom: clamp(1.5rem, 3vw, 2.75rem);
  }

  .reviews__head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .reviews__controls { display: flex; gap: 0.6rem; }
  .reviews__arrow {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(15, 59, 46, 0.35);
    border-radius: 50%;
    color: var(--emerald);
    transition: background-color 0.35s, color 0.35s, border-color 0.35s;
  }
  .reviews__arrow:hover { background: var(--emerald); color: var(--ivory); border-color: var(--emerald); }
  .reviews__arrow svg { width: 1.1rem; height: 1.1rem; }

  .reviews__viewport { position: relative; }
  .reviews__track {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    overflow-x: auto;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 0.5rem 1.5rem;
    cursor: grab;
  }
  .reviews__track.is-dragging { cursor: grabbing; }
  .reviews__track::-webkit-scrollbar { display: none; }

  /* No frame: each review is a column of type opened by a gold hairline,
     the same rule that runs through the credentials and the index. */
  .reviews__card {
    position: relative;
    flex: 0 0 clamp(17rem, 25vw, 23rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(184, 150, 79, 0.45);
  }
  .reviews__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .reviews__card-logo {
    height: 1.05rem;
    width: auto;
    opacity: 0.75;
  }
  .reviews__proc { color: var(--emerald); }
  .reviews__quote {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    flex: 1;
  }
  .reviews__quote p {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reviews__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--ink-mute);
  }
</style>
