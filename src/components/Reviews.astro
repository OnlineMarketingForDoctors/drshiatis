---
import { reviews, DOCTIFY_URL } from '../data/reviews.js';
import Stars from './Stars.astro';
---

<section class="reviews section bg-paper" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews__head" data-reveal-group>
      <div class="reviews__brand" data-reveal>
        <a href={DOCTIFY_URL} target="_blank" rel="noopener" class="reviews__doctify">
          <img src="/images/doctify.svg" alt="Doctify" width="120" height="32" loading="lazy" decoding="async" />
        </a>
        <div class="reviews__score">
          <Stars />
          <span class="small">5.0 from verified patients</span>
        </div>
      </div>
      <h2 class="h2 reviews__title" id="reviews-title" data-reveal>In their <em class="italic">own words</em></h2>
      <div class="reviews__controls" data-reveal>
        <button class="reviews__arrow" type="button" data-reviews-prev aria-label="Previous reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>
        <button class="reviews__arrow" type="button" data-reviews-next aria-label="Next reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="reviews__viewport" data-reviews>
    <ul class="reviews__track container" data-reviews-track>
      {reviews.map((r) => (
        <li class="reviews__card" data-reviews-card>
          <Stars class="reviews__stars" />
          <p class="eyebrow reviews__proc">{r.procedure}</p>
          <blockquote class="reviews__quote">
            <p>{r.text}</p>
          </blockquote>
          <footer class="reviews__meta small">
            <span>Verified patient</span>
            <span aria-hidden="true">·</span>
            <time>{r.date}</time>
          </footer>
        </li>
      ))}
    </ul>
  </div>

  <div class="container reviews__foot" data-reveal-group>
    <a class="link-rule" href={DOCTIFY_URL} target="_blank" rel="noopener" data-reveal>Read all reviews on Doctify</a>
  </div>
</section>

<style>
  .reviews { overflow: hidden; }

  .reviews__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .reviews__brand { display: flex; flex-direction: column; gap: 0.6rem; }
  .reviews__doctify img { height: 1.6rem; width: auto; }
  .reviews__score { display: flex; align-items: center; gap: 0.6rem; color: var(--ink-soft); }
  .reviews__title { text-align: center; }

  .reviews__controls { display: flex; gap: 0.6rem; }
  .reviews__arrow {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(15, 59, 46, 0.35);
    border-radius: 50%;
    color: var(--emerald);
    transition: background-color 0.35s, color 0.35s, border-color 0.35s;
  }
  .reviews__arrow:hover { background: var(--emerald); color: var(--ivory); border-color: var(--emerald); }
  .reviews__arrow svg { width: 1.1rem; height: 1.1rem; }

  .reviews__viewport { position: relative; }
  .reviews__track {
    display: flex;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 0.5rem 1.5rem;
    cursor: grab;
  }
  .reviews__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .reviews__track::-webkit-scrollbar { display: none; }

  .reviews__card {
    flex: 0 0 clamp(18rem, 27vw, 25rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.2vw, 2.2rem);
    background: var(--ivory);
    border: 1px solid rgba(184, 150, 79, 0.35);
    transition: border-color 0.4s, transform 0.6s var(--ease-out);
  }
  .reviews__card:hover { border-color: var(--gold); }
  .reviews__proc { color: var(--emerald); }
  .reviews__quote {
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.5;
    color: var(--ink);
    flex: 1;
  }
  .reviews__quote p {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reviews__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--ink-mute);
    padding-top: 0.9rem;
    border-top: 1px solid rgba(28, 27, 24, 0.1);
  }

  .reviews__foot { margin-top: 1rem; color: var(--emerald); }

  @media (max-width: 900px) {
    .reviews__head { grid-template-columns: 1fr auto; }
    .reviews__title { grid-column: 1 / -1; text-align: left; order: -1; }
  }
</style>
