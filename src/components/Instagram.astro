---
import { site } from '../data/site.js';

const tiles = [
  { src: '/images/ig-4.webp', alt: 'Mr Shiatis in surgical scrubs' },
  { src: '/images/ig-5.webp', alt: 'Mr Shiatis outside St Bartholomew\'s Hospital' },
  { src: '/images/ig-2.webp', alt: 'Surgeon\'s hands resting on a leather notebook' },
  { src: '/images/ig-6.webp', alt: 'Mr Shiatis in the operating theatre' },
  { src: '/images/ig-3.webp', alt: 'A white orchid in a brass vase' },
  { src: '/images/ig-7.webp', alt: 'Mr Shiatis outdoors in London' },
  { src: '/images/ig-8.webp', alt: 'Mr Shiatis seated in a consulting room' },
];
---

<section class="ig section--tight bg-ivory" aria-labelledby="ig-title">
  <div class="container ig__head" data-reveal-group>
    <p class="eyebrow eyebrow--gold" data-reveal>Follow along</p>
    <h2 class="h2" id="ig-title" data-reveal>Follow <em class="italic">along</em></h2>
    <a class="ig__handle" href={site.instagram} target="_blank" rel="noopener" data-reveal>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/></svg>
      <span>{site.instagramHandle}</span>
    </a>
  </div>

  <div class="ig__ticker" data-reveal>
    <div class="ig__track">
      {[0, 1].map((copy) => (
        <ul class="ig__set" aria-hidden={copy === 1}>
          {tiles.map((t) => (
            <li class="ig__tile">
              <a href={site.instagram} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : 0}>
                <img src={t.src} alt={copy === 0 ? t.alt : ''} width="800" height="800" loading="lazy" decoding="async" />
                <span class="ig__overlay" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .ig { overflow: hidden; }
  .ig__head {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .ig__head .h2 { margin-top: 0.8rem; }
  .ig__handle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
    padding-bottom: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--emerald);
    border-bottom: 1px solid var(--gold);
    transition: border-color 0.3s, color 0.3s;
  }
  .ig__handle svg { width: 1.1rem; height: 1.1rem; }
  .ig__handle:hover { border-color: var(--emerald); }

  .ig__ticker {
    --tile: clamp(11rem, 18vw, 17rem);
    --gap: clamp(0.5rem, 1vw, 1rem);
  }
  .ig__track {
    display: flex;
    width: max-content;
    animation: ig-scroll 48s linear infinite;
  }
  .ig__ticker:hover .ig__track,
  .ig__ticker:focus-within .ig__track { animation-play-state: paused; }
  .ig__set {
    display: flex;
    gap: var(--gap);
    padding-right: var(--gap);
  }
  .ig__tile {
    width: var(--tile);
    aspect-ratio: 1;
    flex: none;
    overflow: hidden;
  }
  .ig__tile a { display: block; position: relative; height: 100%; }
  .ig__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .ig__tile a:hover img { transform: scale(1.06); }
  .ig__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(15, 59, 46, 0.55);
    color: var(--ivory);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .ig__overlay svg { width: 1.8rem; height: 1.8rem; }
  .ig__tile a:hover .ig__overlay,
  .ig__tile a:focus-visible .ig__overlay { opacity: 1; }

  @keyframes ig-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  :global(.reduced-motion) .ig__track { animation: none; }
</style>
