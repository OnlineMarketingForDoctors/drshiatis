---
import Monogram from './Monogram.astro';
import SocialIcons from './SocialIcons.astro';
import DoctifyBadge from './DoctifyBadge.astro';
import { site, nav } from '../data/site.js';
import NavList from './NavList.astro';
import { menu } from '../data/menu.js';

interface Props {
  // 'overlay' sits over the hero video; 'solid' is the always-visible bar
  // used on interior pages, which have no hero behind the header.
  variant?: 'overlay' | 'solid';
  path?: string;
}

const { variant = 'overlay', path = '' } = Astro.props;
const solid = variant === 'solid';
---

<!-- Full header, laid over the hero video -->
{!solid && (
<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <div class="site-header__top">
      <div class="site-header__badge">
        <DoctifyBadge />
      </div>

      <a class="site-header__logo" href="/" aria-label={`${site.name} home`}>
        <Monogram />
        <span class="site-header__wordmark">
          <span class="site-header__name">Andreas Shiatis</span>
          <span class="site-header__sub">Plastic Surgery</span>
        </span>
      </a>

      <div class="site-header__actions">
        <a class="site-header__phone" href={site.phoneHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          <span>{site.phoneDisplay}</span>
        </a>
        <a class="btn btn--ivory" href={site.bookingHref}>Book a consultation</a>
      </div>

      <a class="callbtn site-header__call" href={site.phoneHref}>
        <span class="sr-only">Call the practice</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      </a>

      <button class="site-header__burger" type="button" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <span class="site-header__burger-line"></span>
        <span class="site-header__burger-line"></span>
      </button>
    </div>

    <nav class="site-header__nav" aria-label="Primary">
      <NavList path={path} variant="header" />
    </nav>
  </div>
</header>
)}

<!-- Compact bar that slides in once the hero has scrolled away -->
<div class="site-bar" class:list={[{ "is-visible": solid, "site-bar--solid": solid }]} data-site-bar>
  <div class="container site-bar__inner">
    <a class="site-bar__logo" href="/" aria-label={`${site.name} home`}>
      <Monogram />
      <span class="site-bar__wordmark" aria-hidden="true">Andreas Shiatis</span>
    </a>
    <nav class="site-bar__nav" aria-label="Primary, compact">
      <NavList path={path} variant="bar" />
    </nav>
    <div class="site-bar__actions">
      <a class="site-bar__phone" href={site.phoneHref}>{site.phoneDisplay}</a>
      <a class="btn btn--solid site-bar__book" href={site.bookingHref}>
        <span class="site-bar__book-full">Book a consultation</span>
        <span class="site-bar__book-short" aria-hidden="true">Book now</span>
      </a>
      <a class="callbtn site-bar__call" href={site.phoneHref}>
        <span class="sr-only">Call the practice</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      </a>

      <button class="site-header__burger site-bar__burger" type="button" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <span class="site-header__burger-line"></span>
        <span class="site-header__burger-line"></span>
      </button>
    </div>
  </div>
</div>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__inner container">
    <div class="mobile-menu__top">
      <a href="/" class="mobile-menu__logo" aria-label={`${site.name} home`}><Monogram /></a>
      <button class="mobile-menu__close" type="button" data-menu-close>
        <span class="sr-only">Close menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="mobile-menu__list">
        {menu.map((item, i) => (
          <li style={`--i:${i}`}>
            <div class="mobile-menu__row">
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
              {item.columns && (
                <button
                  class="mobile-menu__toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`msub-${item.href.replace(/\//g, '')}`}
                  data-sub-toggle
                >
                  <span class="sr-only">{`Show ${item.label} procedures`}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
              )}
            </div>

            {item.columns && (
              <div class="mobile-menu__sub" id={`msub-${item.href.replace(/\//g, '')}`} hidden>
                {item.columns.map((col) => (
                  <div>
                    {col.title && <p class="mobile-menu__subhead">{col.title}</p>}
                    <ul>
                      {col.items.map((p) => (
                        <li><a href={p.href} target="_blank" rel="noopener">{p.name}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <a class="btn btn--ivory" href={site.bookingHref}>Book a consultation</a>
      <a class="mobile-menu__phone" href={site.phoneHref}>{site.phoneDisplay}</a>
      <DoctifyBadge />
      <div class="mobile-menu__social"><SocialIcons /></div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    color: var(--ivory);
    padding-top: clamp(1rem, 2vw, 1.75rem);
  }

  .site-header__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .site-header__badge { justify-self: start; }

  .site-header__logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: clamp(3.4rem, 5vw, 4.5rem);
  }
  .site-header__logo :global(.monogram) { width: 100%; }
  /* The lockup from the supplied artwork: name over a smaller, wider-tracked
     descriptor, both in the logo's own light geometric sans. */
  .site-header__wordmark {
    display: block;
    font-family: var(--font-logo);
    font-weight: 300;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
  }
  .site-header__name {
    display: block;
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    text-indent: 0.18em; /* balance the trailing letterspace */
  }
  .site-header__sub {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.5rem;
    letter-spacing: 0.21em;
    text-indent: 0.21em;
    color: rgba(244, 238, 228, 0.82);
  }

  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .site-header__phone svg { width: 1rem; height: 1rem; }

  .site-header__nav {
    margin-top: clamp(0.9rem, 1.6vw, 1.4rem);
    padding-top: clamp(0.9rem, 1.6vw, 1.4rem);
    border-top: 1px solid rgba(244, 238, 228, 0.28);
  }
  /* Burger */
  /* Shown wherever the written number has had to go. Sized to the burger it
     sits beside so the pair reads as one control group. */
  .callbtn {
    display: none;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(18, 49, 91, 0.25);
    border-radius: 50%;
    color: var(--emerald);
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .callbtn svg { width: 1.05rem; height: 1.05rem; }
  .callbtn:hover,
  .callbtn:focus-visible {
    background: var(--emerald);
    border-color: var(--emerald);
    color: var(--ivory);
  }
  /* The overlay header sits on the hero, so it inverts. */
  .site-header__call { color: var(--ivory); border-color: rgba(244, 238, 228, 0.45); }
  .site-header__call:hover,
  .site-header__call:focus-visible {
    background: var(--ivory);
    border-color: var(--ivory);
    color: var(--emerald);
  }

  .site-header__burger {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    justify-self: end;
  }
  .site-header__burger-line {
    display: block;
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out), opacity 0.3s;
  }

  /* Compact bar */
  .site-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    background: rgba(244, 238, 228, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(18, 49, 91, 0.1);
    color: var(--emerald);
    transform: translateY(-105%);
    transition: transform 0.55s var(--ease-out);
  }
  .site-bar.is-visible { transform: none; }
  /* Interior pages: the bar is the header, so it never animates in. */
  .site-bar--solid { transition: none; background: var(--ivory); }

  .site-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.25rem;
  }
  .site-bar__logo {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .site-bar__logo :global(.monogram) { width: 2.4rem; flex: none; }
  .site-bar__wordmark {
    font-family: var(--font-logo);
    font-weight: 300;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-bar__actions { display: flex; align-items: center; gap: 1rem; }
  .site-bar__book-short { display: none; }
  .site-bar__phone { font-size: 0.85rem; font-weight: 500; white-space: nowrap; }
  .site-bar .btn { padding: 0.8rem 1.2rem; font-size: 0.7rem; white-space: nowrap; }
  .site-bar__burger { display: none; }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--emerald);
    color: var(--ivory);
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.45s var(--ease-out), visibility 0s linear 0.45s;
  }
  .mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: 1.25rem 2.5rem;
  }
  .mobile-menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mobile-menu__logo { width: 3.2rem; }
  .mobile-menu__close { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; }
  .mobile-menu__close svg { width: 1.6rem; height: 1.6rem; }

  .mobile-menu__list {
    margin-block: auto;
    padding-block: 2.5rem;
  }
  .mobile-menu__list li {
    border-bottom: 1px solid rgba(244, 238, 228, 0.16);
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    transition-delay: calc(0.08s + var(--i) * 0.05s);
  }
  .mobile-menu.is-open .mobile-menu__list li { opacity: 1; transform: none; }
  .mobile-menu__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .mobile-menu__row > a { flex: 1; }
  .mobile-menu__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--gold-light);
  }
  .mobile-menu__toggle svg { width: 1.3rem; height: 1.3rem; transition: rotate 0.3s var(--ease-out); }
  .mobile-menu__toggle[aria-expanded='true'] svg { rotate: 180deg; }

  /* The procedures, which are the old site's pages. */
  .mobile-menu__sub { display: grid; gap: 1.5rem; padding: 0.25rem 0 1.5rem; }
  .mobile-menu__sub[hidden] { display: none; }
  .mobile-menu__subhead {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(216, 189, 124, 0.3);
  }
  .mobile-menu__sub li { border: none; opacity: 1; transform: none; transition: none; }
  .mobile-menu__sub a {
    display: block;
    padding: 0.45rem 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.35;
    color: rgba(244, 238, 228, 0.82);
  }

  .mobile-menu__list > li > .mobile-menu__row > a {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.5vw, 2.1rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  /* Mark where you are, the way the compact bar does. */
  .mobile-menu__list a[aria-current='page'] { color: var(--gold-light); }
  .mobile-menu__foot {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .mobile-menu__phone { font-size: 1.05rem; font-weight: 500; }

  body.menu-open { overflow: hidden; }

  @media (max-width: 1400px) {
    .site-bar__phone { display: none; }
    .site-bar__call { display: grid; }
  }
  /* Only where the bar genuinely runs out of room does the name give way. */
  @media (max-width: 340px) {
    .site-bar__wordmark { display: none; }
  }
  @media (max-width: 1100px) {
    .site-header__phone span { display: none; }
  }

  @media (max-width: 900px) {
    .site-header__top { grid-template-columns: auto 1fr auto auto; }
    .site-header__badge { display: none; }
    .site-header__logo { justify-self: start; flex-direction: row; align-items: center; gap: 0.75rem; width: auto; }
    .site-header__wordmark { text-align: left; }
    .site-header__logo :global(.monogram) { width: 3rem; }
    .site-header__actions { display: none; }
    .site-header__call { display: grid; }
    .site-header__burger { display: flex; }
    .site-header__nav { display: none; }
    .site-bar__nav { display: none; }
    .site-bar__burger { display: flex; }
    .site-bar__wordmark { font-size: 0.6rem; letter-spacing: 0.14em; }
    .site-bar__actions { gap: 0.4rem; }
    .callbtn { width: 2.4rem; height: 2.4rem; }
    .site-bar .btn {
      padding: 0.7rem 0.85rem;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }
    .site-bar__book-full { display: none; }
    .site-bar__book-short { display: inline; }
  }
</style>
