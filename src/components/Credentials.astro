---
const credentials = [
  {
    title: 'FRCS(Plast)',
    text: 'UK specialist qualification in plastic surgery',
    icon: '<circle cx="12" cy="9" r="5.2"/><path d="M8.5 13.3 6.6 21l5.4-2.7L17.4 21l-1.9-7.7"/>',
  },
  {
    title: 'GMC Specialist Register',
    text: 'Registered specialist in Plastic Surgery',
    icon: '<path d="M5.5 3.5h8L19 9v11.5a1 1 0 0 1-1 1H5.5a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1z"/><path d="M13.5 3.5V9H19"/><path d="M8.4 14.8l2.3 2.3 4.4-4.6"/>',
  },
  {
    title: 'NHS Consultant',
    text: 'Barts Health NHS Trust',
    icon: '<path d="M4.5 20.5V9.6L12 4.5l7.5 5.1v10.9"/><path d="M2.5 20.5h19"/><path d="M12 10.6v4.8M9.6 13h4.8"/>',
  },
  {
    title: 'Advanced reconstructive training',
    text: 'Microsurgery fellowship, Imperial College Healthcare NHS',
    icon: '<path d="M10.2 2.8h3.1l1.4 5.9H8.8z"/><path d="M7.2 8.7h9.6"/><path d="M13.6 8.7v2.6a5.6 5.6 0 0 1-5.6 5.6H6.6"/><path d="M4 21h16"/><path d="M9.5 21a6.5 6.5 0 0 0 6.5-6.5V8.7"/>',
  },
  {
    title: 'London practice',
    text: 'Consultations and surgery at established London facilities',
    icon: '<path d="M12 21.2s6.9-6.2 6.9-11.1a6.9 6.9 0 1 0-13.8 0C5.1 15 12 21.2 12 21.2z"/><circle cx="12" cy="10" r="2.4"/>',
  },
];
---

<!-- Black strip directly beneath the hero: the film resolves into it. -->
<section class="creds on-dark" id="credentials" aria-label="Credentials">
  <ul class="container creds__grid" data-reveal-group>
    {credentials.map((c) => (
      <li class="creds__item" data-reveal>
        <span class="creds__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
        </span>
        <span class="creds__copy">
          <span class="creds__title">{c.title}</span>
          <span class="creds__text">{c.text}</span>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .creds {
    background: #111110;
    color: var(--ivory);
    /* A gold hairline keeps the strip from dissolving into the black hero. */
    border-top: 1px solid rgba(216, 189, 124, 0.28);
  }

  /* Five across on a wide screen, folding to three, two, then one. */
  .creds__grid {
    display: grid;
    /* Weighted rather than equal: the columns carry different amounts of
       copy, and this keeps every block to two lines of text. */
    grid-template-columns: 1fr 0.96fr 0.78fr 1.22fr 1.04fr;
    padding-block: clamp(1.35rem, 2.2vw, 1.9rem);
  }

  /* Icon beside the copy, not above it, so the strip stays shallow. */
  .creds__item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding-inline: clamp(0.9rem, 1.8vw, 1.6rem);
    border-left: 1px solid rgba(216, 189, 124, 0.22);
  }
  .creds__item:first-child { border-left: 0; padding-left: 0; }
  .creds__item:last-child { padding-right: 0; }

  .creds__icon { flex: none; color: var(--gold-light); }
  .creds__icon svg { width: 1.35rem; height: 1.35rem; }

  .creds__copy { display: block; }

  .creds__title {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--ivory);
  }

  .creds__text {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: rgba(244, 238, 228, 0.68);
  }

  @media (max-width: 1180px) {
    .creds__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.35rem 0; }
    .creds__item:first-child { padding-left: clamp(0.9rem, 1.8vw, 1.6rem); }
    .creds__item:last-child { padding-right: clamp(0.9rem, 1.8vw, 1.6rem); }
    /* Restart the hairline at the head of each row. */
    .creds__item:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
  }

  @media (max-width: 760px) {
    .creds__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .creds__item:nth-child(3n + 1) { border-left: 1px solid rgba(216, 189, 124, 0.22); padding-left: clamp(0.9rem, 1.8vw, 1.6rem); }
    .creds__item:nth-child(2n + 1) { border-left: 0; padding-left: 0; }
  }

  @media (max-width: 520px) {
    .creds__grid { grid-template-columns: 1fr; gap: 1.1rem; }
    .creds__item,
    .creds__item:nth-child(3n + 1),
    .creds__item:nth-child(2n + 1) {
      border-left: 0;
      padding-inline: 0;
    }
  }
</style>
