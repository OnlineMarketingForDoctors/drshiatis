---
import Monogram from './Monogram.astro';
import { site } from '../data/site.js';
---

<!-- Opens the ivory run under the hero: who he is, and how the practice works. -->
<section class="intro">
  <div class="container intro__inner" data-reveal-group>
    <span class="intro__mark" data-reveal><Monogram /></span>

    <p class="intro__text" data-reveal>
      {site.surgeon} is a Consultant Plastic Surgeon in London, with an NHS reconstructive
      practice standing behind every aesthetic decision. Privately he operates at
      <a href={site.pantheons} target="_blank" rel="noopener">Pantheons Clinic</a>, a boutique
      practice built around innovation, offering cutting-edge treatment in an elegant and
      comfortable space in Central London.
    </p>
    <p class="intro__text intro__text--after" data-reveal>
      Two consultations before anything is booked, a straight answer about what surgery can
      and cannot do, and a plan shaped by your own anatomy.
    </p>
  </div>
</section>

<style>
  .intro {
    background: var(--ivory-2);
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* The mark from the logo, standing over the intro as an ornament. */
  .intro__mark {
    display: block;
    width: clamp(2.75rem, 4.5vw, 3.75rem);
    margin-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--gold);
  }

  .intro__text a {
    border-bottom: 1px solid rgba(184, 150, 79, 0.55);
    transition: border-color 0.3s;
  }
  .intro__text a:hover { border-color: var(--gold); }
  .intro__text--after { margin-top: 1.1rem; }

  .intro__text {
    max-width: 46em;
    text-align: center;
    text-wrap: pretty;
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    line-height: 1.5;
    color: var(--emerald);
  }
</style>
