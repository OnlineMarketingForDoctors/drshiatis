---
// A card per procedure: image, what kind of thing it is, what it does, where it
// is used, what to expect, and a way through to the detail.
interface Props {
  items: {
    name: string;
    kind: string;
    note: string;
    areas: string;
    detail: string;
    img: string;
    alt: string;
    href: string;
  }[];
  label?: string;
  /* How many cards sit on a row at full width. Three and four items each want
     a different answer, so the caller says rather than the grid guessing. */
  columns?: number;
  more?: string;
}
const { items, label = 'Procedures', columns = 3, more = 'More on this' } = Astro.props;
// Links that leave the site open in a new tab; pages here do not.
const ext = (href) => (href.startsWith('http') ? '_blank' : null);
const rel = (href) => (href.startsWith('http') ? 'noopener' : null);
---

<section class="pgrid section" aria-label={label}>
  <div class="container">
    <ul class="pgrid__grid" style={`--pgrid-cols:${columns}`} data-reveal-group>
      {items.map((t) => (
        <li class="pcard" data-reveal>
          <div class="cover pcard__img" data-img-reveal>
            <img src={t.img} alt={t.alt} width="1800" height="1208" loading="lazy" decoding="async" />
          </div>

          <div class="pcard__body">
            <p class="eyebrow eyebrow--gold pcard__kind">{t.kind}</p>
            <h2 class="pcard__name">{t.name}</h2>
            <p class="pcard__note">{t.note}</p>

            <dl class="pcard__meta">
              <div><dt>Where</dt><dd>{t.areas}</dd></div>
              <div><dt>What to expect</dt><dd>{t.detail}</dd></div>
            </dl>

            <a class="pcard__more" href={t.href} target={ext(t.href)} rel={rel(t.href)}>
              {more}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pgrid__grid {
    display: grid;
    grid-template-columns: repeat(var(--pgrid-cols, 3), minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .pcard__img { aspect-ratio: 3 / 2; }
  .pcard__body { padding-top: clamp(1.25rem, 2vw, 1.75rem); }
  .pcard__kind { color: var(--gold); }
  .pcard__name {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-h3);
    line-height: 1.1;
    color: var(--emerald);
    text-wrap: balance;
  }
  .pcard__note {
    margin-top: 0.85rem;
    max-width: 34em;
    color: var(--ink-soft);
  }

  .pcard__meta {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(184, 150, 79, 0.4);
  }
  .pcard__meta dt {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .pcard__meta dd {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.35rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid rgba(184, 150, 79, 0.5);
    padding-bottom: 0.15rem;
    transition: color 0.3s, border-color 0.3s;
  }
  .pcard__more svg { width: 0.8rem; height: 0.8rem; }
  .pcard__more:hover { color: var(--emerald); border-color: var(--emerald); }

  /* A three-up row is too tight for the card below a laptop, and anything
     narrower than a tablet reads better as a single column. */
  @media (max-width: 1040px) {
    .pgrid__grid { grid-template-columns: repeat(min(var(--pgrid-cols, 3), 2), minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .pgrid__grid { grid-template-columns: 1fr; }
  }
</style>
