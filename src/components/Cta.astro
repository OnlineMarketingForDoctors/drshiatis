---
import { site } from '../data/site.js';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__bg" aria-hidden="true" data-parallax data-parallax-strength="8">
    <img src="/images/cta-room.webp" alt="" width="2400" height="1018" loading="lazy" decoding="async" />
  </div>

  <div class="container cta__inner" data-reveal-group>
    <p class="eyebrow eyebrow--gold" data-reveal>Begin</p>
    <h2 class="h2" id="cta-title" data-reveal>Start with <em class="italic">a conversation</em></h2>
    <p class="lead measure-narrow" data-reveal>
      Two consultations before any decision, with Mr Shiatis himself. Tell us what you are considering and a patient coordinator will be in touch.
    </p>
    <div class="cta__actions" data-reveal>
      <a class="btn btn--solid" href={site.bookingHref}>
        Book a consultation
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--outline" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      <a class="btn btn--outline" href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <p class="small cta__email" data-reveal>
      Or email <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--ivory-2);
  }
  .cta__bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
  }
  .cta__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 85% center; }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(244, 238, 228, 0.97) 0%, rgba(244, 238, 228, 0.95) 42%, rgba(244, 238, 228, 0.75) 60%, rgba(244, 238, 228, 0.15) 85%, rgba(244, 238, 228, 0.05) 100%);
  }

  .cta__inner {
    padding-block: var(--section);
    max-width: none;
  }
  .cta__inner .h2 { margin-top: 1rem; max-width: 12em; }
  .cta__inner .lead { margin-top: 1.5rem; color: var(--ink-soft); }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .cta__email { margin-top: 1.5rem; color: var(--ink-soft); }
  .cta__email a { color: var(--emerald); border-bottom: 1px solid rgba(15, 59, 46, 0.35); }

  @media (max-width: 700px) {
    .cta::before { background: rgba(244, 238, 228, 0.9); }
  }
</style>
