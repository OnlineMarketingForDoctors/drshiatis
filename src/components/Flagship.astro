---
// The practice describes itself as breast and body surgery, so the two
// columns are those two families rather than an arbitrary split.
const families = [
  {
    label: 'Breast',
    items: [
      {
        name: 'Breast Augmentation',
        note: 'Implant or fat transfer, sized to your own proportions',
        href: '/surgical',
        img: '/images/flag-breast-augmentation.webp',
        alt: 'Shoulder and collarbone in an ivory silk camisole against blush marble',
      },
      {
        name: 'Breast Lift',
        note: 'Reshaping and lifting, with the shortest scar the lift allows',
        href: '/surgical',
        img: '/images/flag-breast-lift.webp',
        alt: 'Close crop of an ivory silk camisole and decolletage against pale marble',
      },
      {
        name: 'Breast Reduction',
        note: 'Relief from the weight, shape considered as closely as size',
        href: '/surgical',
        img: '/images/flag-breast-reduction.webp',
        alt: 'Woman standing in profile in a loose ivory linen shirt by a window',
      },
    ],
  },
  {
    label: 'Body',
    items: [
      {
        name: 'Tummy Tuck',
        note: 'Skin and muscle repair after pregnancy or weight loss',
        href: '/surgical',
        img: '/images/flag-tummy-tuck.webp',
        alt: 'Waist in high-waisted ivory silk trousers against pale marble',
      },
      {
        name: 'Gynaecomastia Surgery',
        note: 'Chest contouring for men, often under local anaesthetic',
        href: '/for-men',
        img: '/images/flag-gynaecomastia.webp',
        alt: 'A man\'s bare chest and shoulders against a deep emerald backdrop',
      },
      {
        name: 'Body Contouring / Liposuction',
        note: 'Ultrasound-assisted, working with the shape you have',
        href: '/surgical',
        img: '/images/flag-body-contouring.webp',
        alt: 'Pale plaster torso sculpture on a stone plinth in raking light',
      },
    ],
  },
];
---

<section class="flag section" id="flagship" aria-label="Flagship procedures">
  <div class="container">
    <div class="flag__intro" data-reveal-group>
      <p data-reveal>
        Most of the practice is breast and body surgery. These are the operations Mr Shiatis is asked for most often. Each one starts the same way: two consultations before any decision, and a plan built around your own anatomy rather than a technique applied to everyone.
      </p>
    </div>

    <div class="flag__index">
      {families.map((f) => (
        <div class="flag__family">
          <h3 class="flag__label">{f.label}</h3>

          <ul class="flag__rows" data-reveal-group>
            {f.items.map((p) => (
              <li data-reveal>
                <a class="flag__row" href={p.href}>
                  <span class="flag__thumb">
                    <img src={p.img} alt={p.alt} width="400" height="400" loading="lazy" decoding="async" />
                  </span>
                  <span class="flag__copy">
                    <span class="flag__name">{p.name}</span>
                    <span class="flag__note">{p.note}</span>
                  </span>
                  <span class="flag__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 6l6 6-6 6"/></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .flag { background: var(--ivory-2); }

  /* No heading here, so the intro carries the section: set larger than body
     copy and in the emerald the procedure names use. */
  .flag__intro {
    max-width: 32em;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    line-height: 1.5;
    color: var(--emerald);
  }

  /* Two columns, one per family, divided by the brand's gold hairline. */
  .flag__index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .flag__family { padding-inline: clamp(1rem, 2.5vw, 2.75rem); }
  .flag__family:first-child { padding-left: 0; }
  .flag__family:last-child {
    padding-right: 0;
    border-left: 1px solid rgba(184, 150, 79, 0.4);
  }

  .flag__label {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(184, 150, 79, 0.4);
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .flag__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 1.5rem;
    align-items: center;
    column-gap: clamp(0.9rem, 1.5vw, 1.35rem);
    padding: clamp(0.85rem, 1.3vw, 1.15rem) clamp(0.7rem, 1.1vw, 1rem);
    border-bottom: 1px solid rgba(184, 150, 79, 0.3);
  }

  /* Signature: emerald sweeps across the row from the column edge outwards. */
  .flag__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--emerald);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.42s var(--ease-out);
  }
  .flag__row:hover::before,
  .flag__row:focus-visible::before { transform: scaleX(1); }

  .flag__thumb {
    display: block;
    width: clamp(3.4rem, 4.8vw, 4.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--ivory);
  }
  .flag__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .flag__row:hover .flag__thumb img,
  .flag__row:focus-visible .flag__thumb img { transform: scale(1.07); }

  .flag__copy { display: block; }

  .flag__name {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--emerald);
    /* Delayed so the wash leads the recolour rather than racing it. */
    transition: color 0.28s var(--ease-out) 0.16s;
  }
  .flag__note {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-soft);
    transition: color 0.28s var(--ease-out) 0.16s;
  }

  .flag__arrow {
    justify-self: end;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-0.5rem);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out), color 0.4s;
  }
  .flag__arrow svg { width: 1.25rem; height: 1.25rem; }

  .flag__row:hover .flag__name,
  .flag__row:focus-visible .flag__name { color: var(--ivory); }
  .flag__row:hover .flag__note,
  .flag__row:focus-visible .flag__note { color: rgba(244, 238, 228, 0.78); }
  .flag__row:hover .flag__arrow,
  .flag__row:focus-visible .flag__arrow {
    opacity: 1;
    transform: none;
    color: var(--gold-light);
  }

  :global(.reduced-motion) .flag__row::before,
  :global(.reduced-motion) .flag__thumb img,
  :global(.reduced-motion) .flag__arrow { transition: none; }

  @media (max-width: 900px) {
    /* One column: the families stack, the divider lies down between them. */
    .flag__index { grid-template-columns: 1fr; }
    .flag__family { padding-inline: 0; }
    .flag__family:last-child {
      border-left: 0;
      margin-top: clamp(2rem, 5vw, 3rem);
    }
    .flag__row {
      padding-inline: 0;
      /* No hover on touch, so the sweep would only ever half-fire. */
    }
    .flag__row::before { display: none; }
    .flag__arrow { opacity: 1; transform: none; }
  }

  @media (max-width: 420px) {
    .flag__row { column-gap: 0.85rem; }
    .flag__arrow { display: none; }
    .flag__row { grid-template-columns: auto minmax(0, 1fr); }
  }
</style>
