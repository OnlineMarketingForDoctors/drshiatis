---
import { site } from '../data/site.js';
---

<a class="wa" href={site.whatsappHref} target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5A9.5 9.5 0 0 0 3.9 16.9L2.5 21.5l4.7-1.3A9.5 9.5 0 1 0 12 2.5zm0 1.7a7.8 7.8 0 1 1-4 14.5l-.3-.2-2.8.8.8-2.7-.2-.3A7.8 7.8 0 0 1 12 4.2zm-3 4c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.1-1.4l-.5-.3-1.9-.9c-.3-.1-.4-.1-.6.1l-.9 1.1c-.2.2-.3.2-.6.1a7 7 0 0 1-2.1-1.3 7.8 7.8 0 0 1-1.4-1.8c-.2-.3 0-.4.1-.5l.4-.5.3-.5v-.5l-.9-2.1c-.2-.5-.4-.5-.6-.5H9z"/></svg>
  <span class="wa__label">WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: calc(clamp(1rem, 2.5vw, 2rem) + 3.2rem + 0.75rem);
    z-index: 25;
    display: flex;
    align-items: center;
    gap: 0;
    height: 3.2rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 12px 30px rgba(10, 42, 33, 0.25);
    transition: background-color 0.3s, transform 0.3s var(--ease-out), gap 0.3s var(--ease-out);
  }
  .wa:hover { background: #1fb457; transform: translateY(-2px); gap: 0.55rem; }
  .wa svg { width: 1.5rem; height: 1.5rem; flex: none; }
  .wa__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: max-width 0.4s var(--ease-out);
  }
  .wa:hover .wa__label,
  .wa:focus-visible .wa__label { max-width: 8rem; }

  @media (max-width: 700px) {
    .wa__label { display: none; }
  }
</style>
