---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProcedureGrid from '../components/ProcedureGrid.astro';
import PageCta from '../components/PageCta.astro';
import { site } from '../data/site.js';
import { treatments } from '../data/nonsurgical.js';
---

<Base
  variant="solid"
  title="Non-Surgical Treatments | Mr Andreas Shiatis, Consultant Plastic Surgeon"
  description="Non-surgical treatments with Mr Andreas Shiatis, Consultant Plastic Surgeon in London: anti-wrinkle injections, Profhilo, polynucleotides and treatment for excessive sweating."
>
  <PageHead
    eyebrow="Non-surgical"
    title="Treatment"
    titleEm="without surgery"
    id="nshead-title"
    lead="A short list, deliberately. Injectable treatments for the skin, for the muscles beneath it, and for excessive sweating. All are done in clinic, most in under half an hour, and you go back to your day afterwards. They are offered in their own right, not as a step towards an operation."
  >
    <div class="phead__actions" data-reveal>
      <a class="btn btn--ivory" href={site.bookingHref}>
        Book a consultation
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--outline-light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </PageHead>

  <ProcedureGrid items={treatments} label="Treatments" columns={2} more="More on this treatment" />

  <PageCta
    eyebrow="Not sure which"
    title="Start with"
    titleEm="a conversation"
    id="nsend-title"
    lead="Several of these do similar things by different routes, and what people ask for is not always what suits their skin. Come in and we will work out which, if any, is right for you."
  />
</Base>
