---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Reviews from '../components/Reviews.astro';
import SectionNav from '../components/SectionNav.astro';
import BaCarousel from '../components/BaCarousel.astro';
import Meet from '../components/Meet.astro';
import PageCta from '../components/PageCta.astro';
import { site } from '../data/site.js';
import {
  hero, byline, sections, gallery, glance, overview, benefitsLead, benefits,
  suitability, typesLead, types, techniques, statement, journeyLead, steps,
  recoveryLead, recovery, cost, whyLead, why, faqs,
} from '../data/tummy-tuck.js';

const icons = {
  clock: 'M12 7v5l3 2M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Z',
  moon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z',
  home: 'M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z',
  case: 'M3 8h18v12H3zM9 8V5h6v3',
  car: 'M12 3 20 20l-8-4-8 4Z',
  activity: 'M3 12h4l2.5-7 4 14L16 12h5',
  shield: 'M12 3 20 6v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6Z',
  check: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Zm-3.5-9 2.5 2.5L16 9',
  pin: 'M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Zm0-8.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z',
  tag: 'M3 12V4h8l9 9-8 8-9-9Zm4.5-4.5h.01',
  drop: 'M12 3.5s6 6.2 6 10a6 6 0 0 1-12 0c0-3.8 6-10 6-10Z',
};
---

<Base
  variant="solid"
  path="/tummy-tuck"
  title="Tummy Tuck London | Abdominoplasty"
  description="A firmer abdomen starts with a carefully considered plan. Explore personalised tummy tuck surgery with highly experienced plastic surgeon Mr Andreas Shiatis."
>
  <!-- Hero -->
  <PageHead
    eyebrow={hero.eyebrow}
    title={hero.title}
    titleEm={hero.titleEm}
    id="tthead-title"
    img="/images/su-body.webp"
    imgPosition="50% 40%"
    scrim="left"
    full
    lead={hero.lead}
  >
    <ul class="herolist" data-reveal>
      {hero.points.map((p) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L19 7"/></svg>
          <span>{p}</span>
        </li>
      ))}
    </ul>

    <div class="phead__actions" data-reveal>
      <a class="btn btn--ivory" href={site.bookingHref}>
        Book online
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn--outline-light" href="#before-after">See before and after</a>
    </div>
  </PageHead>

  <!-- Reviews: only the body surgery ones, so no breast reviews land here -->
  <Reviews />

  <!-- In-page nav -->
  <SectionNav sections={sections} />

  <!-- Byline and medical review line -->
  <p class="medrev">
    {byline}. Medically reviewed by {site.surgeon} (GMC number {site.gmc}),
    {site.qualifications}, Consultant Plastic and Reconstructive Surgeon.
  </p>

  <!-- Before and after -->
  <section class="section" id="before-after" aria-labelledby="ba-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow eyebrow--gold" data-reveal>Before and after</p>
        <h2 class="h2 shead__title" id="ba-title" data-reveal>His own patients, <em class="italic">his own results</em></h2>
        <p class="shead__lead" data-reveal>
          Photographed in clinic from the same angles before and after, published with written
          consent, cropped but otherwise untouched.
        </p>
      </header>
      <BaCarousel procedure={gallery} label={gallery.label} href={`/before-and-after#${gallery.slug}`} />
    </div>
  </section>

  <!-- At a glance: the facts on a card, over a full-bleed photograph -->
  <section class="glanceband" id="at-a-glance" aria-labelledby="gl-title">
    <div class="glanceband__bg" aria-hidden="true" data-parallax data-parallax-strength="8">
      <img src="/images/ba-room.webp" alt="" width="2000" height="1342" loading="lazy" decoding="async" />
    </div>
    <div class="container glanceband__inner">
      <div class="glancecard" data-reveal-group>
        <p class="eyebrow eyebrow--gold" data-reveal>At a glance</p>
        <h2 class="h2 glancecard__title" id="gl-title" data-reveal>Tummy tuck <em class="italic">at a glance</em></h2>
        <p class="glancecard__lead" data-reveal>
          A guide to what to expect. Every plan is individual, so Mr Shiatis confirms your own
          timings at your consultation.
        </p>

        <ul class="glance">
          {glance.map((g) => (
            <li class="glance__item" data-reveal>
              <svg class="glance__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[g.icon]}/></svg>
              <div>
                <p class="glance__label">{g.label}</p>
                <p class="glance__value">{g.value}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Overview: copy inside the container, photograph running off the right edge -->
  <section class="section bg-ivory-2 flush" id="overview" aria-labelledby="ov-title">
    <div class="container">
      <div class="flush__copy">
        <p class="eyebrow eyebrow--gold" data-reveal>Overview</p>
        <h2 class="h2 shead__title" id="ov-title" data-reveal>What is <em class="italic">a tummy tuck</em></h2>
        <div class="prose split__prose" data-reveal>
          {overview.paragraphs.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </div>
    <figure class="flush__fig" data-reveal>
      <div class="cover flush__img" data-img-reveal>
        <img src="/images/ba-plan.webp" alt="A measuring tape, skin marker and calipers on a sheet of paper on a consulting desk" width="1120" height="1400" loading="lazy" decoding="async" />
      </div>
      <figcaption class="flush__cap">{overview.caption}</figcaption>
    </figure>
  </section>

  <!-- Benefits -->
  <section class="section bg-emerald on-dark" id="benefits" aria-labelledby="bn-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow" data-reveal>Benefits</p>
        <h2 class="h2 shead__title" id="bn-title" data-reveal>What are the benefits of <em class="italic">a tummy tuck</em></h2>
        <p class="shead__lead" data-reveal>{benefitsLead}</p>
      </header>
      <ol class="cards" data-reveal-group>
        {benefits.map((b, i) => (
          <li class="card" data-reveal>
            <span class="card__n italic" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__title">{b.title}</h3>
            <p class="card__text">{b.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Suitability -->
  <section class="section" id="candidates" aria-labelledby="cd-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow eyebrow--gold" data-reveal>Suitability</p>
        <h2 class="h2 shead__title" id="cd-title" data-reveal>Who is suitable for <em class="italic">tummy tuck surgery</em></h2>
      </header>
      <p class="suitprose" data-reveal>{suitability}</p>
    </div>
  </section>

  <!-- Types and techniques -->
  <section class="section bg-ivory-2" id="types" aria-labelledby="ty-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow eyebrow--gold" data-reveal>Types and techniques</p>
        <h2 class="h2 shead__title" id="ty-title" data-reveal>Tummy tuck types <em class="italic">and techniques</em></h2>
        <p class="shead__lead" data-reveal>{typesLead}</p>
      </header>

      <ul class="types" data-reveal-group>
        {types.map((t) => (
          <li class="type" data-reveal>
            <h3 class="type__title">{t.title}</h3>
            <p class="type__text">{t.text}</p>
          </li>
        ))}
      </ul>

      <div class="tgroup">
        <h3 class="tgroup__title" data-reveal>Techniques used alongside</h3>
        <ul class="types types--three" data-reveal-group>
          {techniques.map((t) => (
            <li class="type type--soft" data-reveal>
              <h4 class="type__title">{t.title}</h4>
              <p class="type__text">{t.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- A pause, on the surgeon rather than the procedure -->
  <section class="statement on-dark" aria-label="About Mr Shiatis">
    <div class="statement__bg" aria-hidden="true" data-parallax data-parallax-strength="10">
      <img src="/images/ba-silk.webp" alt="" width="2400" height="1018" loading="lazy" decoding="async" />
    </div>
    <div class="container statement__inner" data-reveal-group>
      <p class="eyebrow" data-reveal>Your surgeon</p>
      <p class="statement__line" data-reveal>{statement}</p>
    </div>
  </section>

  <!-- Your surgery: the heading holds its place while the steps run past -->
  <section class="section" id="journey" aria-labelledby="jr-title">
    <div class="container jrn">
      <div class="jrn__aside">
        <div class="jrn__sticky">
          <p class="eyebrow eyebrow--gold" data-reveal>Your surgery</p>
          <h2 class="h2 shead__title" id="jr-title" data-reveal>Your tummy tuck <em class="italic">with Mr Shiatis</em></h2>
          <p class="shead__lead" data-reveal>{journeyLead}</p>
          <figure class="jrn__fig" data-reveal>
            <div class="cover jrn__img" data-img-reveal>
              <img src="/images/consult.webp" alt="Mr Shiatis talking through the options at his consulting desk" width="1800" height="1208" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
      </div>

      <ol class="steps" data-reveal-group>
        {steps.map((s) => (
          <li class="step" data-reveal>
            <span class="step__n italic" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
            <div>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Recovery -->
  <section class="section bg-ivory-2" id="recovery" aria-labelledby="rc-title">
    <div class="container rec">
      <div class="rec__copy">
        <p class="eyebrow eyebrow--gold" data-reveal>Recovery</p>
        <h2 class="h2 shead__title" id="rc-title" data-reveal>Recovery <em class="italic">and aftercare</em></h2>
        <p class="shead__lead" data-reveal>{recoveryLead}</p>
        <dl class="timeline" data-reveal-group>
          {recovery.map((r) => (
            <div class="timeline__row" data-reveal>
              <dt>{r.when}</dt>
              <dd>{r.text}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="rec__stack rec__stack--one">
        <figure class="rec__fig" data-reveal>
          <div class="cover rec__img" data-img-reveal>
            <img src="/images/ba-rest.webp" alt="A bed made up with ivory linen, with books and tea on the bedside table" width="1120" height="1400" loading="lazy" decoding="async" />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Cost -->
  <section class="section" id="cost" aria-labelledby="co-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow eyebrow--gold" data-reveal>Cost</p>
        <h2 class="h2 shead__title" id="co-title" data-reveal>How much does a tummy tuck <em class="italic">cost in London</em></h2>
      </header>
      <div class="costbox" data-reveal>
        <p class="costbox__from"><span>From</span> <strong>{cost.from}</strong></p>
        <div class="costbox__inc">
          <p class="costbox__note">{cost.notes}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Mr Shiatis -->
  <section class="section bg-emerald on-dark" id="surgeon" aria-labelledby="wh-title">
    <div class="container">
      <header class="shead">
        <p class="eyebrow" data-reveal>Why him</p>
        <h2 class="h2 shead__title" id="wh-title" data-reveal>Why choose Mr Andreas Shiatis <em class="italic">for a tummy tuck</em></h2>
        <p class="shead__lead" data-reveal>{whyLead}</p>
      </header>
      <ul class="cards" data-reveal-group>
        {why.map((w, i) => (
          <li class="card" data-reveal>
            <span class="card__n italic" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__title">{w.title}</h3>
            <p class="card__text">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Meet />

  <!-- FAQs -->
  <section class="section bg-ivory-2" id="faqs" aria-labelledby="fq-title">
    <div class="container faqwrap">
      <header class="shead">
        <p class="eyebrow eyebrow--gold" data-reveal>Questions</p>
        <h2 class="h2 shead__title" id="fq-title" data-reveal>Tummy tuck <em class="italic">FAQs</em></h2>
      </header>
      <div class="faqs" data-reveal-group>
        {faqs.map((f) => (
          <details class="faq" data-reveal>
            <summary>
              <span>{f.q}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <PageCta
    eyebrow="Next step"
    title="Book your tummy tuck"
    titleEm="consultation"
    id="ttend-title"
    lead="If loose abdominal skin or changes after pregnancy or weight loss are affecting your comfort or confidence, a consultation with Mr Shiatis gives you the opportunity to discuss your options. He will assess your abdomen and explain the procedure that could address your concerns, together with the scars, recovery and cost involved."
  />
</Base>

<style is:global>
  /* Hero selling points, which sit in the head's slot. */
  .herolist { display: grid; gap: 0.6rem; margin-top: 1.75rem; }
  .herolist li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(244, 238, 228, 0.92);
  }
  .herolist svg { flex: none; width: 1rem; height: 1rem; margin-top: 0.25rem; color: var(--gold-light); }
</style>

<style>
  /* Anchor jumps land below the site bar and the section nav, not under them. */
  .section[id] { scroll-margin-top: 7.5rem; }

  /* Shared section furniture */
  .shead { max-width: 46rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .shead--centre { margin-inline: auto; text-align: center; }
  .shead__title { margin-top: 0.9rem; }
  .shead__lead { margin-top: 1.1rem; font-size: var(--fs-lead); line-height: 1.55; color: var(--ink-soft); }
  .on-dark .shead__lead { color: rgba(244, 238, 228, 0.82); }
  .split__prose { margin-top: 1.25rem; }

  /* The medical review line */
  .medrev {
    width: min(100% - 2.5rem, 48rem);
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: center;
    color: var(--ink-soft);
    opacity: 0.85;
  }

  /* Overview: copy inside the container, photograph flush to the page edge */
  .flush { position: relative; overflow: hidden; }
  .flush__fig { margin: 0; }
  @media (min-width: 901px) {
    .flush__copy { max-width: 46%; }
    .flush__fig { position: absolute; inset-block: 0; right: 0; width: 42%; }
    .flush__img { height: 100%; }
  }
  @media (max-width: 900px) {
    .flush__fig { margin-top: clamp(2rem, 5vw, 3rem); }
    .flush__img { aspect-ratio: 4 / 5; }
  }

  /* At a glance: the facts on a card, over a full-bleed photograph */
  .glanceband {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--emerald-deep);
  }
  .glanceband__bg { position: absolute; inset: -8% 0; z-index: -2; }
  .glanceband__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 72% 42%; }
  .glanceband::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(9, 29, 56, 0.94) 0%, rgba(9, 29, 56, 0.88) 46%, rgba(9, 29, 56, 0.5) 74%, rgba(9, 29, 56, 0.22) 100%);
  }
  .glanceband__inner { padding-block: var(--section); max-width: var(--container); }
  .glancecard {
    max-width: 54rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background: var(--paper);
    box-shadow: 0 2.5rem 5rem -2.5rem rgba(9, 29, 56, 0.6);
  }
  .glancecard__title { margin-top: 0.9rem; }
  .glancecard__lead { margin-top: 1rem; font-size: var(--fs-lead); line-height: 1.55; color: var(--ink-soft); }
  .glancecard .glance { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: none; gap: 0 clamp(1.5rem, 3vw, 3rem); }

  
  
  
  
  
  /* Space below rather than above, or the second column starts lower than the first. */
  
  
  /* Two columns only where there is room for them to balance evenly. */
  

  
  
  
  
  
  

  /* Journey: the heading holds its place while the steps run past */
  /* No align-items here: the aside has to fill the row, or the sticky child
     has no room to travel and never sticks. */
  .jrn { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4.5rem); }
  .jrn__sticky { position: sticky; top: 9rem; }
  .jrn__fig { margin: clamp(1.75rem, 3vw, 2.5rem) 0 0; }
  .jrn__img { aspect-ratio: 5 / 4; }
  .jrn__img img { object-position: 50% 62%; }
  .jrn .steps { max-width: none; }

  /* Recovery: the timeline, with two staggered plates alongside */
  .rec { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .rec__fig { margin: 0; width: 64%; }
  .rec__fig--b {
    position: relative;
    z-index: 1;
    margin-left: 36%;
    margin-top: -22%;
    /* A ring of the section colour, so the upper plate reads as the nearer one. */
    outline: clamp(0.4rem, 1vw, 0.75rem) solid var(--ivory);
  }
  .rec__img { aspect-ratio: 4 / 5; }

  /* A full-bleed pause between recovery and risks */
  .statement { position: relative; overflow: hidden; isolation: isolate; background: var(--emerald-deep); }
  .statement__bg { position: absolute; inset: -10% 0; z-index: -2; }
  .statement__bg img { width: 100%; height: 100%; object-fit: cover; }
  .statement::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(9, 29, 56, 0.9), rgba(9, 29, 56, 0.84));
  }
  .statement__inner { max-width: 56rem; padding-block: clamp(4rem, 8vw, 7rem); text-align: center; }
  .statement__line {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 96;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.1vw, 2.8rem);
    line-height: 1.2;
    color: var(--ivory);
  }
  .statement__line em { color: var(--gold-light); }

  /* At a glance */
  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 4.5rem);
    max-width: 62rem;
    margin-inline: auto;
  }
  .glance__item {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding-block: clamp(1.1rem, 2vw, 1.5rem);
    border-top: 1px solid rgba(184, 150, 79, 0.4);
  }
  .glance__icon { flex: none; width: 1.6rem; height: 1.6rem; color: var(--gold); margin-top: 0.15rem; }
  .glance__label { font-weight: 500; color: var(--emerald); }
  .glance__value { margin-top: 0.25rem; font-size: 0.95rem; color: var(--ink-soft); }

  /* Numbered cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .card { padding-top: 1.25rem; border-top: 1px solid rgba(216, 189, 124, 0.4); }
  .card__n { display: block; font-family: var(--font-display); font-size: 1.1rem; color: var(--gold-light); }
  .card__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .card__text { margin-top: 0.6rem; font-size: 0.92rem; line-height: 1.6; color: rgba(244, 238, 228, 0.82); }

  
  
  .suit { padding-top: 1.25rem; border-top: 2px solid var(--gold); }
  
  .suit__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-size: 1.35rem;
    color: var(--emerald);
  }
  .suit ul { margin-top: 1rem; display: grid; gap: 0.7rem; }
  .suit li { position: relative; padding-left: 1.4rem; font-size: 0.95rem; line-height: 1.5; color: var(--ink-soft); }
  .suit li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 0.5rem; height: 1px; background: var(--gold); }
  .suit__note { margin-top: clamp(1.75rem, 3vw, 2.5rem); max-width: 44em; font-size: 0.92rem; color: var(--ink-soft); }

  
  
  
  
  
  
  

  
  
  
  
  
  
  

  /* Journey */
  .steps { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); max-width: 52rem; }
  .step { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.25rem; padding-top: 1.1rem; border-top: 1px solid rgba(184, 150, 79, 0.4); }
  .step__n { font-family: var(--font-display); font-size: 1.3rem; color: var(--gold); }
  .step__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--emerald);
  }
