---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { areas } from '../data/surgical.js';

const total = areas.reduce((n, a) => n + a.items.length, 0);
---

<Base
  variant="solid"
  title="Surgical Procedures | Mr Andreas Shiatis, Consultant Plastic Surgeon"
  description="Surgical procedures with Mr Andreas Shiatis, Consultant Plastic Surgeon in London: breast, body, face and reconstructive surgery."
>
  <!-- Page head -->
  <section class="suhead on-dark" aria-labelledby="suhead-title">
    <div class="suhead__bg" aria-hidden="true">
      <img src="/images/satin.webp" alt="" width="1800" height="1005" fetchpriority="high" decoding="async" />
    </div>

    <div class="container suhead__inner">
      <div class="suhead__copy">
        <p class="eyebrow" data-reveal>Surgical</p>
        <h1 class="h2 suhead__title" id="suhead-title" data-reveal>
          What Mr Shiatis <em class="italic">operates on</em>
        </h1>
        <p class="lead" data-reveal>
          Breast and body surgery is most of the practice, alongside smaller facial procedures
          and the reconstructive work he does for the NHS. Every plan is built around your own
          anatomy, and nothing is decided before a second consultation.
        </p>

        <nav class="suhead__jump" aria-label="Areas" data-reveal>
          {areas.map((a) => (
            <a href={`#${a.slug}`}>{a.label}<span aria-hidden="true"> ({a.items.length})</span></a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- One section per area -->
  {areas.map((area, i) => (
    <section class={`suarea section ${i % 2 ? 'bg-ivory-2' : ''}`} id={area.slug} aria-labelledby={`${area.slug}-title`}>
      <div class="container suarea__grid" data-reveal-group>
        <figure class={`suarea__figure ${i % 2 ? 'suarea__figure--right' : ''}`}>
          <div class="cover suarea__img" data-img-reveal>
            <img src={area.img} alt={area.alt} width="1800" height="1208" loading="lazy" decoding="async" />
          </div>
        </figure>

        <div class="suarea__body">
          <p class="eyebrow eyebrow--gold" data-reveal>{area.label}</p>
          <h2 class="h2 suarea__title" id={`${area.slug}-title`} data-reveal>{area.title}</h2>
          <p class="suarea__intro" data-reveal>{area.intro}</p>

          <ul class="suarea__list">
            {area.items.map((p) => (
              <li data-reveal>
                <a class="suitem" href={p.href} target="_blank" rel="noopener">
                  <span class="suitem__name">{p.name}</span>
                  <span class="suitem__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <!-- Closing -->
  <section class="suend bg-emerald on-dark" aria-labelledby="suend-title">
    <div class="container suend__inner" data-reveal-group>
      <div>
        <p class="eyebrow" data-reveal>{total} procedures</p>
        <h2 class="h2" id="suend-title" data-reveal>Not sure <em class="italic">which one</em></h2>
        <p class="lead measure" data-reveal>
          Most people arrive describing a result rather than an operation, which is the right way
          round. Tell us what you would like to change and Mr Shiatis will tell you honestly what
          surgery can and cannot do about it.
        </p>
      </div>
      <div class="suend__actions" data-reveal>
        <a class="btn btn--ivory" href={site.bookingHref}>Book a consultation</a>
        <a class="btn btn--outline-light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .suhead {
    position: relative;
    overflow: clip;
    isolation: isolate;
    background: var(--emerald);
    color: var(--ivory);
  }
  .suhead__bg { position: absolute; inset: 0; z-index: -2; opacity: 0.5; }
  .suhead__bg img { width: 100%; height: 100%; object-fit: cover; }
  .suhead::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(9, 29, 56, 0.35), rgba(9, 29, 56, 0.8));
  }
  .suhead__inner { padding-block: clamp(3.5rem, 9vw, 7rem); }
  .suhead__copy { max-width: 46rem; }
  .suhead__title { margin-top: 1rem; }
  .suhead__copy .lead { margin-top: 1.5rem; max-width: 36em; }

  /* Four areas, one page: the jump links save a long scroll. */
  .suhead__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid rgba(216, 189, 124, 0.4);
  }
  .suhead__jump a {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ivory);
    border-bottom: 1px solid rgba(216, 189, 124, 0.5);
    padding-bottom: 0.2rem;
    transition: border-color 0.3s, color 0.3s;
  }
  .suhead__jump a span { color: var(--gold-light); }
  .suhead__jump a:hover { color: var(--gold-light); border-color: var(--gold-light); }

  /* Area: image one side, procedures the other, sides alternating */
  .suarea__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .suarea__figure--right { order: 2; }
  .suarea__img {
    position: sticky;
    top: 6.5rem;
    aspect-ratio: 3 / 4;
  }
  .suarea__title { margin-top: 1rem; color: var(--emerald); }
  .suarea__intro {
    margin-top: 1.25rem;
    max-width: 34em;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .suarea__list { margin-top: clamp(1.75rem, 3.5vw, 2.5rem); }
  .suarea__list li:last-child .suitem { border-bottom: 1px solid rgba(184, 150, 79, 0.4); }

  .suitem {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(0.9rem, 1.6vw, 1.25rem);
    border-top: 1px solid rgba(184, 150, 79, 0.4);
  }
  .suitem__name {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    line-height: 1.15;
    color: var(--emerald);
    transition: color 0.3s;
  }
  .suitem__arrow {
    flex: none;
    color: var(--gold);
    opacity: 0;
    transform: translate(-0.4rem, 0.4rem);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .suitem__arrow svg { width: 1rem; height: 1rem; }
  .suitem:hover .suitem__arrow,
  .suitem:focus-visible .suitem__arrow { opacity: 1; transform: none; }
  .suitem:hover .suitem__name,
  .suitem:focus-visible .suitem__name { color: var(--navy-soft); }

  /* Closing */
  .suend__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .suend__inner .h2 { margin-top: 1rem; }
  .suend__inner .lead { margin-top: 1.25rem; }
  .suend__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (max-width: 900px) {
    .suarea__grid { grid-template-columns: 1fr; }
    .suarea__figure--right { order: 0; }
    .suarea__img { position: static; aspect-ratio: 3 / 2; }
    /* No hover on touch, so the arrow stays put. */
    .suitem__arrow { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .suend__actions { flex-direction: column; align-items: stretch; width: 100%; }
    .suend__actions .btn { justify-content: center; }
  }
</style>
